# Az Ansible generalja - KEZZEL NE SZERKESZD, minden futasnal felulirodik.
# Forras: roles/stack/templates/env.j2
#
# A jelszavak a GEPEN keletkeztek, es sosem kerultek a repoba. Ha ez a fajl
# mar letezett, az Ansible a MEGLEVO ertekeket hasznalja tovabb - kulonben a
# meglevo adatbazis elerhetetlenne valna.
#
# FIGYELEM: a szokozos ertekeket idezojelezni kell. A Compose enelkul is jol
# kezeli, de egy shell, ami source-olja ezt a fajlt, a masodik szot parancsnak
# nezne.

POSTGRES_AIRFLOW_DB={{ pg_airflow_db }}
POSTGRES_AIRFLOW_USER={{ pg_airflow_user }}
POSTGRES_AIRFLOW_PASSWORD={{ titkok.POSTGRES_AIRFLOW_PASSWORD }}

POSTGRES_APP_DB={{ pg_app_db }}
POSTGRES_APP_USER={{ pg_app_user }}
POSTGRES_APP_PASSWORD={{ titkok.POSTGRES_APP_PASSWORD }}

REDIS_MAXMEMORY={{ redis_maxmemory }}
